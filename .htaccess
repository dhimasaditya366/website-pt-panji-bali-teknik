# Allow /admin, /katalog, /kontak, etc. to serve the matching .html file
# without redirecting or changing the URL bar. Existing links that still
# include ".html" keep working exactly as before.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [NC,L]

# Serve the site's own 404 page instead of the host's default one
ErrorDocument 404 /404.html

# Hostinger's default 7-day cache applies to every .js/.css file, not just
# data.js. That means every code fix (bug fixes, new features) stays
# invisible to a returning visitor's browser for up to a week, since the
# <script src="..."> tags don't change their URL between deploys. Force
# revalidation on every load for all of this site's own JS/CSS so a normal
# refresh always picks up the latest deployed code, not just the latest
# published content.
<IfModule mod_headers.c>
<FilesMatch "\.(js|css)$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
</IfModule>
